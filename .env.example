# --- shared secrets: used both for container bootstrap (docker compose
# variable substitution reads this file automatically) and by the updater
# app itself (via env_file:) -- one file serves both purposes. ---
CONTROL_DB_PASSWORD=REPLACE_generate_with_openssl_rand_base64_24
TARGET_DB_PASSWORD=REPLACE_generate_with_openssl_rand_base64_24
VPIC_USER_PASSWORD=REPLACE_generate_with_openssl_rand_base64_24

# --- control-db (vpic_meta: locking, promotion pointer, audit log) ---
CONTROL_DB_HOST=control-db
CONTROL_DB_PORT=5432
CONTROL_DB_USER=vpic_admin
CONTROL_DB_NAME=vpic_meta

# --- target-db (per-release vpic_{year_month} databases) ---
TARGET_DB_HOST=target-db
TARGET_DB_PORT=5432
TARGET_DB_USER=vpic_admin
TARGET_DB_NAME=postgres

APP_ROLE=vpic_user

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/REAL

DOWNLOAD_DIR=data/downloads
EXTRACT_DIR=data/extracted
LOG_DIR=logs