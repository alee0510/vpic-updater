# --- control-db (vpic_meta: locking, promotion pointer, audit log) ---
CONTROL_DB_HOST=localhost
CONTROL_DB_PORT=5433
CONTROL_DB_USER=vpic_admin
CONTROL_DB_PASSWORD=changeme
CONTROL_DB_NAME=vpic_meta

# --- target-db (per-release vpic_{year_month} databases) ---
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5434
TARGET_DB_USER=vpic_admin
TARGET_DB_PASSWORD=changeme
TARGET_DB_NAME=postgres

# --- application role granted read access to each new release db ---
APP_ROLE=vpic_user

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# --- local working directories (relative to project root) ---
DOWNLOAD_DIR=data/downloads
EXTRACT_DIR=data/extracted