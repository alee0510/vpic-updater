# Applied once, automatically, when each Postgres container's data volume
# is first initialized (see docker/postgres/set-hba.sh). This file is not
# meant to be hand-edited on a running container — to change it, edit this
# template and recreate the container against a fresh volume, matching the
# "one-time, not per-version" design decision made earlier in this project.
#
# NOTE: SSL/TLS is not configured on these containers (out of scope for
# this deployment) -- these rules rely on Docker's network isolation
# (private bridge subnet, no public port exposure) rather than
# encryption-in-transit. If that changes, switch `host` to `hostssl` here.

local   all             all                                     peer

# vpic-updater automation -- restricted to the fixed Docker bridge subnet
# used by this project's docker-compose network, never 0.0.0.0/0.
host    vpic_meta       vpic_admin      172.28.0.0/24            scram-sha-256
host    all             vpic_admin      172.28.0.0/24            scram-sha-256
host    all             vpic_user       172.28.0.0/24            scram-sha-256

# Loopback access -- lets you psql in via an SSH tunnel or directly on
# the VPS itself (127.0.0.1:5433 / 127.0.0.1:5434) for manual inspection.
host    all             all             127.0.0.1/32             scram-sha-256

# Explicit deny-all fallback. Postgres already rejects unmatched
# connections by default; this makes that intent unambiguous. Must be last.
host    all             all             0.0.0.0/0                reject